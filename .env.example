# Copy to .env.local at the repo root and fill in. .env.local is gitignored.
# apps/mobile (metro.config.js) and services/shopper-worker (dev script) both load it.
# Local development uses the hosted Supabase project (no container runtime on the dev Mac).
EXPO_PUBLIC_SUPABASE_URL=            # hosted project: Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=       # hosted project: Settings -> API -> anon key
SUPABASE_SERVICE_ROLE_KEY=           # worker and Edge Functions only
ANTHROPIC_API_KEY=
KROGER_CLIENT_ID=                    # developer.kroger.com app (WS07)
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=mealplanner://oauth/kroger
EXPO_PUBLIC_POSTHOG_KEY=             # also read by apps/marketing: one anonymous pageview if set
# apps/marketing (Astro) reads the three EXPO_PUBLIC_ variables above from this same file. It
# also reads this one, only at build time, for absolute canonical and Open Graph URLs.
# Optional. Leave empty locally; set it to the Cloudflare Pages URL in CI.
MARKETING_SITE_URL=
SENTRY_DSN=
# Hosted: the Supavisor pooler in session mode (port 5432). The transaction pooler (6543)
# needs `prepare: false` in postgres.js.
WORKER_DATABASE_URL=
# Developer tool only: personal access token for the Supabase CLI (link, db push,
# functions deploy). Never used by the app or the worker.
SUPABASE_ACCESS_TOKEN=

# --- WS01: auth and invites ---------------------------------------------------------------
# Origin of the deployed web app. Invite links are <origin>/join/<token>. Development: the
# Expo web server. Leave empty to share mealplanner://join/<token> deep links instead.
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:8081
# Developer tool only: the hosted project's ref (the host part of EXPO_PUBLIC_SUPABASE_URL).
# `pnpm --filter @mp/db gen-types` reads types from that project when this is set.
SUPABASE_PROJECT_REF=
#
# Redirect URLs (Authentication -> URL Configuration -> Redirect URLs). Development, which
# supabase/config.toml lists for the local stack:
#   http://localhost:8081/**      Expo web dev server: /callback and /join/<token>
#   mealplanner://**              Native deep links
#   exp://**                      Expo Go on a LAN address
# Production lists only the deployed web origin and the native callback, never the wildcards above:
#   https://<web-origin>/callback
#   mealplanner://callback        (add the Tauri origin tauri://localhost in WS13)
# Site URL: http://localhost:8081 in development, the deployed web origin in production.
#
# Apple and Google sign-in. Configure them in the dashboard (Authentication -> Providers); see
# supabase/README.md §Auth. These four are read by supabase/config.toml only if you set
# enabled = true there for a stack you run yourself. Leave them out otherwise: the CLI refuses
# to start when an enabled provider has an empty value.
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=     # iOS bundle id, then the Services ID, comma separated
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=        # signed JWT from your Apple key; it expires in 6 months
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
