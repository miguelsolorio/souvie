# Copy to .env.local at the repo root and fill in. .env.local is gitignored.
# apps/mobile (metro.config.js) and services/shopper-worker (dev script) both load it.
# Local development uses the hosted Supabase project (no container runtime on the dev Mac).
EXPO_PUBLIC_SUPABASE_URL=            # hosted project: Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=       # hosted project: Settings -> API -> anon key
SUPABASE_SERVICE_ROLE_KEY=           # worker and Edge Functions only
ANTHROPIC_API_KEY=
KROGER_CLIENT_ID=                    # developer.kroger.com app (WS07)
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=souvie://oauth/kroger
EXPO_PUBLIC_POSTHOG_KEY=             # also read by apps/marketing: one anonymous pageview if set
# apps/marketing (Astro) reads the three EXPO_PUBLIC_ variables above from this same file. It
# also reads this one, only at build time, for absolute canonical and Open Graph URLs.
# Optional. Leave empty locally; set it to the Cloudflare Pages URL in CI.
MARKETING_SITE_URL=
SENTRY_DSN=
# Hosted: the Supavisor pooler in session mode (port 5432). The transaction pooler (6543)
# needs `prepare: false` in postgres.js.
WORKER_DATABASE_URL=
# Developer tool only: personal access token for the Supabase CLI (link, db push,
# functions deploy). Never used by the app or the worker.
SUPABASE_ACCESS_TOKEN=

# --- WS01: auth and invites ---------------------------------------------------------------
# Origin of the deployed web app. Invite links are <origin>/join/<token>. Development: the
# Expo web server. Leave empty to share souvie://join/<token> deep links instead.
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:8081
# Developer tool only: the hosted project's ref (the host part of EXPO_PUBLIC_SUPABASE_URL).
# `pnpm --filter @mp/db gen-types` reads types from that project when this is set.
SUPABASE_PROJECT_REF=
#
# Redirect URLs (Authentication -> URL Configuration -> Redirect URLs). Development, which
# supabase/config.toml lists for the local stack:
#   http://localhost:8081/**      Expo web dev server: /callback and /join/<token>
#   souvie://**              Native deep links
#   exp://**                      Expo Go on a LAN address
# Production lists only the deployed web origin and the native callback, never the wildcards above:
#   https://<web-origin>/callback
#   souvie://callback        (add the Tauri origin tauri://localhost in WS13)
# Site URL: http://localhost:8081 in development, the deployed web origin in production.
#
# Apple and Google sign-in. Configure them in the dashboard (Authentication -> Providers); see
# supabase/README.md §Auth. These four are read by supabase/config.toml only if you set
# enabled = true there for a stack you run yourself. Leave them out otherwise: the CLI refuses
# to start when an enabled provider has an empty value.
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=     # iOS bundle id, then the Services ID, comma separated
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=        # signed JWT from your Apple key; it expires in 6 months
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- WS02: recipes and import ---------------------------------------------------------------
# recipe-import is an Edge Function, so it reads these as Supabase secrets, not from this file:
#   supabase secrets set ANTHROPIC_API_KEY=... AI_DAILY_CAP_USD=2 --project-ref <ref>
# Without ANTHROPIC_API_KEY only the scraper path works; text, photo, caption, and the model
# fallback answer "model_unavailable". The packages/recipe-import live eval also reads
# ANTHROPIC_API_KEY from .env.local or the environment.
# USD one household may spend on model calls per UTC day when its own cap cannot be read. Default 2.
# Each household's cap is households.ai_daily_cap_usd (default 2.00, set with a service-role
# statement; WS15). With no household, a user is capped at this value for their own calls.
AI_DAILY_CAP_USD=

# --- WS07: Kroger (QFC, Fred Meyer) ------------------------------------------------------------
# KROGER_CLIENT_ID, KROGER_CLIENT_SECRET, and KROGER_REDIRECT_URI are listed above. The
# retailer-oauth Edge Function reads them as Supabase secrets, not from this file:
#   supabase secrets set KROGER_CLIENT_ID=... KROGER_CLIENT_SECRET=... KROGER_REDIRECT_URI=souvie://oauth/kroger --project-ref <ref>
# `supabase functions serve retailer-oauth --env-file .env.local` reads them from here instead.
# The client secret never goes in the app: only the function and the worker hold it.
# Optional. Empty means production (https://api.kroger.com/v1). The certification host
# https://api-ce.kroger.com/v1 serves catalog calls only and has no customer accounts.
KROGER_API_BASE=
# Developer tool only: set to 1 to run the live smoke test, which calls api.kroger.com and adds
# one item to your own Kroger cart. Never set in CI.
KROGER_LIVE_TEST=
# Developer tool only: your own Kroger refresh token for the live test's cart step.
# `pnpm --filter @mp/retailers kroger:login` writes it to .env.kroger.local (gitignored, mode 600),
# so it does not belong in this file. KROGER_ENV_FILE points the live test at another env file
# (for example the main checkout's, from a worktree).
# KROGER_LIVE_REFRESH_TOKEN=

# --- WS06: onboarding and suggestions -----------------------------------------------------------
# The suggest Edge Function reads these as Supabase secrets, not from this file:
#   supabase secrets set ANTHROPIC_API_KEY=... VOYAGE_API_KEY=... AI_DAILY_CAP_USD=2 --project-ref <ref>
# `supabase functions serve suggest --env-file .env.local` reads them from here instead. It also
# needs SUPABASE_DB_URL, which Supabase sets for every function (hosted and local serve).
# Voyage AI voyage-3 embeds recipes and taste profiles (1024 dimensions). Without it suggestions
# rank by cuisine and popularity and nothing is embedded. Free tier at voyageai.com.
VOYAGE_API_KEY=
# Developer tool only: set to 1 to run the live cases of the suggest eval (a real Sonnet
# composition, a real Voyage embedding). Needs ANTHROPIC_API_KEY and VOYAGE_API_KEY. Never in CI.
EVAL_LIVE=

# --- WS16: starter catalog ----------------------------------------------------------------------
# `pnpm --filter @mp/recipe-import draft-catalog` is a one-time local script. It reads
# ANTHROPIC_API_KEY (listed above) from its process environment, not from this file: export that one
# key from .env.local before running it. It refuses to run when CI is set and stops at --max-usd.
# Loading the catalog into the hosted project uses WORKER_DATABASE_URL (see supabase/seed/README.md).

# --- WS04: planner ---------------------------------------------------------------------------
# Public flag, read at build time. Set to 1 once the suggest Edge Function (WS06) is deployed with
# mode "swap" (one recipe for one slot, nothing written). It shows "Suggest one for me" on a planned
# meal. Empty or 0: the planner offers the manual recipe picker only and never calls suggest.
EXPO_PUBLIC_SUGGEST_ENABLED=

# --- WS05: grocery list ---------------------------------------------------------------------
# No new variables. The list-build Edge Function uses SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and
# SUPABASE_DB_URL, which Supabase sets for every function (hosted, and `supabase functions serve
# list-build`). The app keeps its check-off queue on the device and needs no flag for it.

# --- WS08: Tier 3 assisted checkout host --------------------------------------------------------
# EXPO_PUBLIC_POSTHOG_KEY (listed above) also feeds the Tier 3 kill switch, PostHog flag
# tier3_browser_checkout. Without a key the switch reads as on; it is off only when PostHog says so.
#
# The llm-proxy Edge Function reads these as Supabase secrets, not from this file:
#   supabase secrets set ANTHROPIC_API_KEY=... AI_DAILY_CAP_USD=2 LLM_PROXY_MAX_TOKENS_PER_CALL=4096 LLM_PROXY_RUN_CAP_USD=1 --project-ref <ref>
# `supabase functions serve llm-proxy --env-file .env.local` reads them from here instead.
# Output tokens one on-device agent call may ask for. Default 4096.
LLM_PROXY_MAX_TOKENS_PER_CALL=
# USD one Tier 3 run may spend on model calls; a request may ask for less, never more. Default 1.
LLM_PROXY_RUN_CAP_USD=
# The static test page the (dev)/snapshot tool opens. Serve it with
# `pnpm --filter @mp/mobile tier3:test-page` (port 8790; the Simulator reaches the Mac's localhost).
# A public static host (Cloudflare Pages or GitHub Pages) replaces this URL later. The brief calls it
# TIER3_TEST_PAGE_URL; Expo inlines only EXPO_PUBLIC_ variables into the app, hence the prefix.
EXPO_PUBLIC_TIER3_TEST_PAGE_URL=http://localhost:8790/

# --- WS09: shopping agent and worker -------------------------------------------------------------
# WORKER_DATABASE_URL is listed above. The worker runs every statement on application tables as
# service_role (set local role) and calls pgmq as the connection role. It also reads
# ANTHROPIC_API_KEY and AI_DAILY_CAP_USD (above) for the model calls, and KROGER_CLIENT_ID,
# KROGER_CLIENT_SECRET and KROGER_API_BASE (above) for the Kroger adapter. Without the model key,
# code picks the close calls and flags them for review.
# Runs one worker process handles at once, 1 to 8. Empty means 2.
WORKER_CONCURRENCY=
# Seconds between heartbeats while the worker holds a run, 5 to 30. Empty means 30. Every worker
# sweeps with one fixed threshold, 90 seconds (STALE_AFTER_SECONDS in
# services/shopper-worker/src/heartbeat.ts): a stale approved push is resumed, anything else fails.
WORKER_HEARTBEAT_SECONDS=
# live (empty): the Kroger adapter. mock: MockRetailer for every store, for local development and
# the CI smoke run. The worker refuses mock when NODE_ENV is production.
WORKER_RETAILER_MODE=
# Optional. An Expo access token, needed only when the Expo project turns on enhanced push
# security. The worker reads it from its own environment; the app never holds it.
EXPO_PUSH_ACCESS_TOKEN=
# The run-approve Edge Function needs no new variable: it uses SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL, which Supabase sets for every function.
# The app registers push tokens only with an EAS project id in app.json (extra.eas.projectId).

# --- WS15: observability and evals ----------------------------------------------------------------
# Sentry and PostHog stay off, and nothing is sent, until their keys are set. Names only here: the
# values are secrets or project keys and live in .env.local, EAS secrets and the worker host's secret
# store, never in the repo. What may leave the app and the worker is in docs/05 §Privacy.
#
# App (read at build time; Expo inlines EXPO_PUBLIC_ values):
#   EXPO_PUBLIC_SENTRY_DSN          the app's Sentry DSN (a different project from the worker's)
#   EXPO_PUBLIC_SENTRY_ENVIRONMENT  optional: production, staging. Default development in a dev build
#   EXPO_PUBLIC_GIT_SHA             the release: set it to the git SHA of the build, for example
#                                   EXPO_PUBLIC_GIT_SHA=$(git rev-parse HEAD) eas build ...
#   EXPO_PUBLIC_POSTHOG_KEY         listed above; also sends the seven product events and reads flags
#   EXPO_PUBLIC_POSTHOG_HOST        optional. Default https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_GIT_SHA=
EXPO_PUBLIC_POSTHOG_HOST=
# Source maps (EAS build, the @sentry/react-native/expo plugin): set these as EAS secrets, not here.
#   SENTRY_AUTH_TOKEN  SENTRY_ORG  SENTRY_PROJECT  SENTRY_RELEASE (the same git SHA as EXPO_PUBLIC_GIT_SHA)
#
# Edge Functions (suggest, recipe-import, parse-ingredients, llm-proxy report their 500s with a
# plain fetch to Sentry; supabase/functions/_shared/sentry.ts). They read these as Supabase secrets:
#   supabase secrets set SENTRY_DSN=... SENTRY_ENVIRONMENT=production SENTRY_RELEASE=<git sha> --project-ref <ref>
# Use the worker's Sentry project or a third one; without SENTRY_DSN they report nothing.
#
# Worker (services/shopper-worker). SENTRY_DSN is listed above:
#   SENTRY_ENVIRONMENT  optional. Default NODE_ENV
#   GIT_SHA             the release; the Dockerfile takes it as --build-arg GIT_SHA=$(git rev-parse HEAD)
#   POSTHOG_API_KEY     the PostHog project API key; the worker sends run_started and cart_ready and
#                       reads the shopping_agent_enabled and tier3_browser_checkout flags
#   POSTHOG_HOST        optional. Default https://us.i.posthog.com
SENTRY_ENVIRONMENT=
GIT_SHA=
POSTHOG_API_KEY=
POSTHOG_HOST=
#
# Evals. `pnpm eval` runs offline from recordings. EVAL_LIVE=1 (or `pnpm eval --live`) calls the
# models and re-records, and needs ANTHROPIC_API_KEY in the process environment. CI sets
# EVAL_REQUIRE_RECORDINGS=1, which makes a model-path case with no recording a failure. The
# eval.yml live job reads ANTHROPIC_API_KEY from the repository secret of that name.
EVAL_REQUIRE_RECORDINGS=

# --- WS11: schedules and notifications -------------------------------------------------------------
# No Edge Function and no pg_net: pg_cron starts scheduled runs in SQL (enqueue_due_scheduled_runs,
# every 5 minutes) and writes the pushes it decides on to notification_outbox; the shopper worker
# sends them through Expo, with the EXPO_PUSH_ACCESS_TOKEN above. Nothing else to set.
# Seconds between passes over the notification outbox, 5 to 300. Empty means 30. A push held for
# quiet hours goes out within one pass of their end.
WORKER_OUTBOX_SECONDS=
