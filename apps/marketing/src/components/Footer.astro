---
import { site } from "../config";

// Built here, not in the template: Astro drops the space when an expression starts a new line.
const disclaimer = `QFC, Fred Meyer, Safeway, Albertsons, Costco, and Instacart are trademarks of their owners. ${site.name} isn't affiliated with or endorsed by them.`;
---

<footer class="site-footer">
  <div class="container">
    <p class="brand">{site.name}</p>
    <p>Built in Washington. Coming to iOS and web.</p>
    <nav aria-label="Footer">
      <a href="/privacy/">Privacy policy</a>
    </nav>
    <p class="fine">{disclaimer}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .container > * + * {
    margin-top: var(--space-3);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
  }
</style>
