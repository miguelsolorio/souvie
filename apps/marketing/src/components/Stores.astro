---
import { stores } from "../config";
---

<section id="stores" class="band" data-section="stores" aria-labelledby="stores-title">
  <div class="container">
    <h2 id="stores-title">Works with your stores</h2>
    <p class="lead">Works with QFC, Fred Meyer, Safeway, Albertsons, and Costco in Washington.</p>
    <ul class="store-list" aria-label="Stores">
      {stores.map((store) => <li>{store}</li>)}
    </ul>
    <p>
      QFC and Fred Meyer carts fill automatically. Safeway, Albertsons, and Costco lists open ready to shop on
      Instacart.
    </p>
  </div>
</section>

<style>
  .store-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .store-list li {
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-weight: 600;
  }
</style>
