{
  "expo": {
    "name": "Meal Planner",
    "slug": "meal-planner",
    "version": "0.1.0",
    "scheme": "mealplanner",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miguelsolorio.mealplanner"
    },
    "android": {
      "package": "com.miguelsolorio.mealplanner"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Meal Planner uses your photos so you can choose a profile picture."
        }
      ]
    ]
  }
}
