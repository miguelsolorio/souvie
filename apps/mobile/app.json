{
  "expo": {
    "name": "Souvie",
    "slug": "souvie",
    "version": "0.1.0",
    "scheme": "souvie",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miguelsolorio.souvie"
    },
    "android": {
      "package": "com.miguelsolorio.souvie",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F6B4F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2F6B4F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#2F6B4F"
          }
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Souvie uses your photos so you can choose a profile picture or a picture of a recipe.",
          "cameraPermission": "Souvie uses your camera so you can photograph a recipe card or cookbook page."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": ["text/*"]
        }
      ],
      "@sentry/react-native/expo"
    ]
  }
}
