// Regenerates bridge.generated.ts from bridge.js, so the app can inject the bridge as a string
// (Metro would bundle bridge.js as a module, and Hermes does not keep function source text).
//
//   pnpm --filter @mp/mobile tier3:bridge
//
// bridge.test.ts fails when BRIDGE_SOURCE no longer equals bridge.js. Node runs this file directly
// (type stripping), so it uses erasable TypeScript only. The output is formatted with Biome so
// `pnpm lint` stays green.
/// <reference types="node" />
import { spawnSync } from "node:child_process";
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

export const TIER3_DIR = dirname(fileURLToPath(import.meta.url));

export function renderGenerated(text: string): string {
  return [
    "// biome-ignore-all lint/suspicious/noTemplateCurlyInString: bridge.js source, kept as text.",
    "// Generated by `pnpm --filter @mp/mobile tier3:bridge` from bridge.js. Do not edit.",
    "// The injected Tier 3 bridge, as a string. buildBridgeScript (bridgeScript.ts) fills the token.",
    `export const BRIDGE_SOURCE: string = ${JSON.stringify(text)};`,
    "",
  ].join("\n");
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
  const target = join(TIER3_DIR, "bridge.generated.ts");
  writeFileSync(target, renderGenerated(readFileSync(join(TIER3_DIR, "bridge.js"), "utf8")));
  const format = spawnSync("pnpm", ["exec", "biome", "format", "--write", target], {
    encoding: "utf8",
  });
  if (format.status !== 0) {
    process.stderr.write(format.stderr || format.stdout || "biome format failed\n");
    process.exit(format.status ?? 1);
  }
  console.log(`Wrote ${target}`);
}
