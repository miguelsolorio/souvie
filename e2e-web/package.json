{
  "name": "@mp/e2e-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser tests for the static web export (WS13). Playwright lives here and nowhere else.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "e2e:build": "EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 EXPO_PUBLIC_SUPABASE_ANON_KEY=fake-anon-key-for-browser-tests pnpm --filter @mp/mobile export:web",
    "e2e": "playwright test",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
