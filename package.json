{
  "name": "meal-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meal planning and grocery shopping monorepo. See docs/01-architecture.md.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23.0 <23",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node apps/marketing/scripts/check-copy.mjs",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "eval": "vitest run --project evals --passWithNoTests",
    "seed": "node supabase/seed/load.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-pgvector": "0.0.14",
    "@types/node": "^22.20.5",
    "supabase": "2.122.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
