{
  "name": "@mp/recipe-import",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "URL, text, photo, or caption to a normalized recipe.",
  "exports": {
    ".": "./src/index.ts",
    "./share": "./src/share.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "eval": "vitest run --root ../.. --project evals packages/recipe-import/evals",
    "eval:live": "EVAL_LIVE=1 vitest run --root ../.. --project evals packages/recipe-import/evals"
  },
  "dependencies": {
    "@mp/core": "workspace:*",
    "@mp/llm": "workspace:*",
    "cheerio": "^1.2.0",
    "recipe-scrapers": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
