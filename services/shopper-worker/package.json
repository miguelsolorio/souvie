{
  "name": "@mp/shopper-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Long-running Node worker: consumes the pgmq shopping_run queue and hosts the agent loop.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mp/agent": "workspace:*",
    "@mp/core": "workspace:*",
    "@mp/llm": "workspace:*",
    "@mp/retailers": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
